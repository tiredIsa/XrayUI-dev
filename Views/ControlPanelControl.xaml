<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="XrayUI.Views.ControlPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XrayUI.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Grid RowSpacing="10" ColumnSpacing="16"
          Margin="0,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ── Row 0: small button ─────────────────────────────────── -->
        <Grid Grid.Row="0" Grid.Column="1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="2">

                <Button x:Name="TrafficButton" Padding="8" Background="Transparent"
                        VerticalAlignment="Center"
                        BorderBrush="Transparent" Command="{x:Bind ViewModel.ShowTrafficCommand}"
                        AutomationProperties.AutomationId="OpenTrafficMonitor">
                    <Viewbox Width="16" Height="16">
                        <Path Data="M 1,1 L 1,15 L 15,15 M 4,11 L 7,7 L 10,9 L 15,3"
                              Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.5" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Viewbox>
                </Button>

                <Button x:Name="PersonalizeButton"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        Padding="8"
                        Command="{x:Bind ViewModel.ShowPersonalizeCommand}">
                    <FontIcon Glyph="&#xE771;" FontSize="16" />
                </Button>

                <Button Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        Padding="8">
                    <Grid Width="20" Height="20">
                        <FontIcon Glyph="&#xE713;" FontSize="16"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <InfoBadge Style="{StaticResource AttentionDotInfoBadgeStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                   Height="6" Width="6"
                                   Visibility="{x:Bind ViewModel.UpdateBadgeVisibility, Mode=OneWay}" />
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind ViewModel.UpdateMenuText, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.UpdateAppCommand}"
                                            Visibility="{x:Bind ViewModel.UpdateBadgeVisibility, Mode=OneWay}" />
                            <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.UpdateBadgeVisibility, Mode=OneWay}" />
                            <MenuFlyoutItem loc:Localize.Text="ControlPanel_EditPortItem.Text"
                                            Command="{x:Bind ViewModel.EditLocalPortCommand}" />
                            <MenuFlyoutItem loc:Localize.Text="ControlPanel_ViewLogItem.Text"
                                            Command="{x:Bind ViewModel.ShowLogsCommand}" />
                            <MenuFlyoutSubItem loc:Localize.Text="ControlPanel_ProxySettingsItem.Text"
                                               >
                                <RadioMenuFlyoutItem loc:Localize.Text="ControlPanel_GlobalProxyItem.Text"
                                                     GroupName="ProxyModeGroup"
                                                     IsChecked="{x:Bind ViewModel.IsGlobalProxyChecked, Mode=OneWay}"
                                                     IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                     Command="{x:Bind ViewModel.SetProxyModeCommand}"
                                                     CommandParameter="system" />
                                <RadioMenuFlyoutItem loc:Localize.Text="ControlPanel_NoProxyItem.Text"
                                                     GroupName="ProxyModeGroup"
                                                     IsChecked="{x:Bind ViewModel.IsNoTakeoverChecked, Mode=OneWay}"
                                                     IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                     Command="{x:Bind ViewModel.SetProxyModeCommand}"
                                                     CommandParameter="manual" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem loc:Localize.Text="ControlPanel_StartupItem.Text"
                                            Command="{x:Bind ViewModel.OpenStartupSettingsCommand}"
                                            Icon="{x:Bind ViewModel.StartupMenuIcon, Mode=OneWay}" />
                            <MenuFlyoutSubItem loc:Localize.Text="ControlPanel_RoutingSettingsItem.Text"
                                               >
                                <MenuFlyoutItem loc:Localize.Text="ControlPanel_RoutingGlobalItem.Text"
                                                IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.SetRoutingModeCommand}"
                                                CommandParameter="global" />
                                <MenuFlyoutItem loc:Localize.Text="ControlPanel_RoutingSmartItem.Text"
                                                IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.SetRoutingModeCommand}"
                                                CommandParameter="smart" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem loc:Localize.Text="ControlPanel_CustomRulesItem.Text"
                                                IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.ShowCustomRulesCommand}" />
                                <MenuFlyoutItem loc:Localize.Text="ControlPanel_DnsItem.Text"
                                                IsEnabled="{x:Bind ViewModel.IsModeToggleEnabled, Mode=OneWay}"
                                                Command="{x:Bind ViewModel.ShowDnsSettingsCommand}" />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <!-- GitHub button -->
                <Button Background="Transparent"
                        BorderBrush="Transparent"
                        VerticalAlignment="Center"
                        Padding="8"
                        Click="GitHubButton_Click"
                        ToolTipService.ToolTip="GitHub">
                    <Viewbox Width="16" Height="16">
                        <Path Data="{StaticResource GitHubIconPath}"
                              Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Viewbox>
                </Button>

            </StackPanel>
        </Grid>

            <Grid Grid.Row="0" Grid.Column="0"
                  VerticalAlignment="Center" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton MinWidth="88"
                              Content="{x:Bind ViewModel.StartStopButtonContent, Mode=OneWay}"
                              IsChecked="{x:Bind ViewModel.StartStopButtonChecked, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanStartStop, Mode=OneWay}"
                              Command="{x:Bind ViewModel.StartStopCommand}" />
                <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xECCC;"
                              Foreground="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource RunningStatusBrushConverter}}" />
                    <TextBlock Grid.Column="1" FontSize="14"
                               Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               MaxWidth="125"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </ToolTipService.ToolTip>
                    </TextBlock>
                </Grid>
            </Grid>

        <!-- Mode settings have their own row, independent of toolbar widths. -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                <TextBlock loc:Localize.Text="ControlPanel_TunModeLabel.Text"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsTunMode, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsTunToggleEnabled, Mode=OneWay}"
                              OnContent=""
                              OffContent=""
                              MinWidth="0"
                              VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock loc:Localize.Text="ControlPanel_RoutingLbl.Text"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.RoutingModeText, Mode=OneWay}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>

