<?xml version="1.0" encoding="utf-8"?>

<UserControl x:Class="XrayUI.Views.PersonalizeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XrayUI.Helpers"
             xmlns:controls="using:CommunityToolkit.WinUI.Controls"
             xmlns:helpers="using:XrayUI.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="500"
             d:DesignHeight="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/AppSettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollView VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20"
                    Padding="0,0,12,24">

            <!-- ── Header ──────────────────────────────────────────────────── -->
            <TextBlock loc:Localize.Text="Personalize_Header.Text"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />

            <!-- ── Theme ───────────────────────────────────────────────────── -->
            <StackPanel Spacing="10">

                <TextBlock loc:Localize.Text="Personalize_Theme.Text"
                           FontSize="15"
                           FontWeight="SemiBold" />


                <controls:Segmented HorizontalAlignment="Left"
                                    SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}">
                    <controls:Segmented.Resources>
                        <!-- Remove hover highlight — gap between hover fill and outer border looks off -->
                        <SolidColorBrush x:Key="SegmentedItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="SegmentedItemBorderBrushPointerOver" Color="Transparent" />
                    </controls:Segmented.Resources>
                    <controls:SegmentedItem loc:Localize.Content="Personalize_Light.Content"
                                            FontSize="14"
                                            Padding="14,6">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE706;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                    <controls:SegmentedItem loc:Localize.Content="Personalize_Dark.Content"
                                            FontSize="14"
                                            Padding="14,6">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE708;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                    <controls:SegmentedItem loc:Localize.Content="Personalize_FollowSystem.Content"
                                            FontSize="14"
                                            Padding="14,6">
                        <controls:SegmentedItem.Icon>
                            <FontIcon Glyph="&#xE770;" FontSize="16" />
                        </controls:SegmentedItem.Icon>
                    </controls:SegmentedItem>
                </controls:Segmented>
            </StackPanel>
            <!-- ── Backdrop ────────────────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock loc:Localize.Text="Personalize_Backdrop.Text"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <ComboBox HorizontalAlignment="Left"
                          MinWidth="160"
                          SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Mica" />
                    <ComboBoxItem loc:Localize.Content="Personalize_Acrylic.Content" />
                </ComboBox>
            </StackPanel>
            <!-- ── Language & Region ───────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock loc:Localize.Text="Personalize_LanguageLbl.Text"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Expander x:Name="AppLanguageExpander"
                          ExpandDirection="Down"
                          Style="{StaticResource AppSettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid Padding="0,16,16,16"
                              ColumnSpacing="12"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xF2B7;"
                                      VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock loc:Localize.Text="Personalize_AppLanguageTitle.Text"
                                           FontSize="14" />
                                <TextBlock loc:Localize.Text="Personalize_AppLanguageDesc.Text"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox Grid.Column="2"
                                      MinWidth="130"
                                      VerticalAlignment="Center"
                                      ItemsSource="{x:Bind ViewModel.SupportedLanguages, Mode=OneTime}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeLanguage, Mode=OneWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="helpers:LanguageInfo">
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Expander.Header>

                    <!-- Expanded row: region (domestic region for smart routing).
                         Left 58 indents the region text to line up under the header title
                         (header style padding 16 + icon column + ColumnSpacing 12); right 44
                         clears the chevron well so the combo box aligns with the header combo. -->
                    <Border MinHeight="52"
                            Padding="58,8,44,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock loc:Localize.Text="Personalize_RoutingRegionTitle.Text"
                                           FontSize="14" />
                                <TextBlock loc:Localize.Text="Personalize_RoutingRegionDesc.Text"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      MinWidth="130"
                                      VerticalAlignment="Center"
                                      SelectedIndex="{x:Bind ViewModel.SelectedRegionIndex, Mode=TwoWay}">
                                <ComboBoxItem loc:Localize.Content="Personalize_Region_CN.Content" />
                                <ComboBoxItem loc:Localize.Content="Personalize_Region_RU.Content" />
                                <ComboBoxItem loc:Localize.Content="Personalize_Region_IR.Content" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </Expander>

                <InfoBar loc:Localize.Title="Personalize_LangRestartBar.Title"
                         IsOpen="{x:Bind ViewModel.ShowRestartHint, Mode=TwoWay}"
                         Severity="Informational"
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button loc:Localize.Content="Personalize_LangRestartBtn.Content"
                                Click="LanguageRestartButton_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
            <!-- ── Protocol Colors ─────────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Spacing="2">
                        <TextBlock loc:Localize.Text="Personalize_ProtocolColors.Text"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock loc:Localize.Text="Personalize_ProtocolColorsDesc.Text"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.ResetColorsCommand}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            VerticalAlignment="Center"
                            Padding="8,6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <FontIcon Glyph="&#xE72C;"
                                      FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock loc:Localize.Text="Personalize_Reset.Text"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Main protocols card -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <StackPanel>

                        <!-- Shadowsocks / SS -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PathIcon Grid.Column="0"
                                      Width="16" Height="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Data="M17,1.042 L11.436,14.954 L7.958,11.477 L8.653,13.563 L7.03,14.958 L7.03,11.563 L14.984,3.375 L6.047,9.969 L1,8.694 L17,1.042 Z" />
                            <TextBlock Grid.Column="1"
                                       Text="Shadowsocks / SS"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.SsColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.SsColor, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock
                                    Text="{x:Bind ViewModel.SsColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                    FontSize="13"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   Margin="16,0" />

                        <!-- VLESS -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE81E;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="VLESS"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.VlessColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.VlessColor, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock
                                    Text="{x:Bind ViewModel.VlessColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                    FontSize="13"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   Margin="16,0" />

                        <!-- VMess -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE909;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="VMess"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.VmessColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.VmessColor, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock
                                    Text="{x:Bind ViewModel.VmessColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                    FontSize="13"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1"
                                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                   Margin="16,0" />

                        <!-- Hysteria 2 -->
                        <Grid Padding="16,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE945;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="Hysteria 2"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        Background="{x:Bind ViewModel.Hysteria2Color, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Button.Flyout>
                                        <Flyout Placement="Left">
                                            <ColorPicker Color="{x:Bind ViewModel.Hysteria2Color, Mode=TwoWay}"
                                                         IsAlphaEnabled="False"
                                                         IsHexInputVisible="True"
                                                         IsAlphaTextInputVisible="False"
                                                         IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <TextBlock
                                    Text="{x:Bind ViewModel.Hysteria2Color, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                    FontSize="13"
                                    FontFamily="Consolas"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Other fallback card -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid Padding="16,13"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE8B9;"
                                  FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock loc:Localize.Text="Personalize_OtherProtocol.Text"
                                       FontSize="14" />
                            <TextBlock loc:Localize.Text="Personalize_OtherProtocolDesc.Text"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="6"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind ViewModel.FallbackColor, Mode=OneWay, Converter={StaticResource ColorToBrushConverter}}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <ColorPicker Color="{x:Bind ViewModel.FallbackColor, Mode=TwoWay}"
                                                     IsAlphaEnabled="False"
                                                     IsHexInputVisible="True"
                                                     IsAlphaTextInputVisible="False"
                                                     IsMoreButtonVisible="False" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock
                                Text="{x:Bind ViewModel.FallbackColor, Mode=OneWay, Converter={StaticResource ColorToHexStringConverter}}"
                                FontSize="13"
                                FontFamily="Consolas"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Display settings -->
            <StackPanel Spacing="10">
                <TextBlock loc:Localize.Text="Personalize_DisplaySettings.Text"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <!-- Spacing="2", not the section-level 10: these two cards are one grouped
                     settings block (PowerToys-style), so they should sit near-flush. -->
                <StackPanel Spacing="4">
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            >
                        <!-- Right padding 6, not 16: ToggleSwitch's template reserves a fixed 12px
                             trailing spacer, so 6+12 lines the pill up with the Expander chevrons (~18px). -->
                        <Grid Padding="16,13,6,13"
                              ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE8A9;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock x:Name="OpenFilterPanelLabel"
                                           loc:Localize.Text="Personalize_OpenFilterPanelOnStartup.Text"
                                           FontSize="14" />
                                <TextBlock loc:Localize.Text="Personalize_OpenFilterPanelOnStartupDesc.Text"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       AutomationProperties.AccessibilityView="Raw"
                                       Text="{x:Bind OnOffLabel(ViewModel.OpenServerFilterPanelOnStartup), Mode=OneWay}"
                                       VerticalAlignment="Center" />

                            <ToggleSwitch Grid.Column="3"
                                          AutomationProperties.LabeledBy="{x:Bind OpenFilterPanelLabel}"
                                          IsOn="{x:Bind ViewModel.OpenServerFilterPanelOnStartup, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Expander HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              
                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                        <Expander.Header>
                            <Grid Padding="0,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE946;"
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock loc:Localize.Text="Personalize_DetailsHeader.Text"
                                               FontSize="14" />
                                    <TextBlock loc:Localize.Text="Personalize_DetailsDesc.Text"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="-16,-12,-16,-12">
                            <!-- Delay Display -->
                            <CheckBox IsChecked="{x:Bind ViewModel.ShowLatencyInDetails, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="42,10,16,10">
                                <StackPanel VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock loc:Localize.Text="Personalize_DetailLatency.Text"
                                               FontSize="14" />
                                    <TextBlock loc:Localize.Text="Personalize_DetailLatencyDesc.Text"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>

                            <Rectangle Height="1"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- AI Unlock Display -->
                            <CheckBox IsChecked="{x:Bind ViewModel.ShowAiUnlockInDetails, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="42,10,16,10">
                                <StackPanel VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock loc:Localize.Text="Personalize_DetailAiUnlock.Text"
                                               FontSize="14" />
                                    <TextBlock loc:Localize.Text="Personalize_DetailAiUnlockDesc.Text"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>

                            <Rectangle Height="1"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <!-- Group Display -->
                            <CheckBox IsChecked="{x:Bind ViewModel.ShowGroupInDetails, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Margin="42,10,16,10">
                                <StackPanel VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock loc:Localize.Text="Personalize_DetailGroup.Text"
                                               FontSize="14" />
                                    <TextBlock loc:Localize.Text="Personalize_DetailGroupDesc.Text"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <InfoBar loc:Localize.Message="Personalize_DisplaySettingsUnsavedBar.Message"
                         IsOpen="{x:Bind ViewModel.ShowDisplaySettingsUnsavedHint, Mode=TwoWay}"
                         Severity="Informational"
                         IsClosable="True" />
            </StackPanel>

            <!-- Hotkeys -->
            <StackPanel Spacing="10">
                <TextBlock loc:Localize.Text="Personalize_Hotkeys.Text"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Expander HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          Style="{StaticResource AppSettingsExpanderStyle}">
                    <Expander.Header>
                        <Grid Padding="0,16,16,16" ColumnSpacing="12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE92E;"
                                      FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock loc:Localize.Text="Personalize_HotkeysHeader.Text"
                                           FontSize="14" />
                                <TextBlock loc:Localize.Text="Personalize_HotkeysDesc.Text"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <StackPanel>
                        <!-- Toggle start/stop -->
                        <Grid MinHeight="52" Padding="58,10,16,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       loc:Localize.Text="Personalize_HotkeyToggleTitle.Text"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="ToggleHotkeyButton"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="HotkeyButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="12"
                                              Visibility="{x:Bind ViewModel.HotkeyToggleIsSet, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.HotkeyToggleDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Restore from tray -->
                        <Grid MinHeight="52" Padding="58,10,16,10" ColumnSpacing="12"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       loc:Localize.Text="Personalize_HotkeyRestoreTitle.Text"
                                       FontSize="14"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    x:Name="RestoreHotkeyButton"
                                    MinWidth="150"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="HotkeyButton_Click">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;"
                                              FontSize="12"
                                              Visibility="{x:Bind ViewModel.HotkeyRestoreIsSet, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.HotkeyRestoreDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>

                <InfoBar x:Name="HotkeySavedInfoBar"
                         IsOpen="False"
                         Severity="Informational"
                         IsClosable="True" />
            </StackPanel>

            <!-- Data management -->
            <StackPanel Spacing="10">
                <TextBlock loc:Localize.Text="Personalize_DataManagement.Text"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                    <Grid Padding="16,13"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE8F1;"
                                  FontSize="16"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock loc:Localize.Text="Personalize_ImportExportTitle.Text"
                                       FontSize="14" />
                            <TextBlock loc:Localize.Text="Personalize_ImportExportDesc.Text"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="ExportPresetButton"
                                    loc:Localize.Content="Personalize_ExportBtn.Content"
                                    Padding="12,6"
                                    Click="ExportPresetButton_Click" />
                            <DropDownButton x:Name="ImportDropDownButton"
                                            loc:Localize.Content="Personalize_ImportBtn.Content"
                                            Padding="12,6"
                                            >
                                <DropDownButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem x:Name="ImportPresetMenuItem"
                                                        loc:Localize.Text="Personalize_ImportMenuRestore.Text"
                                                        Click="ImportPresetButton_Click" />
                                        <MenuFlyoutItem x:Name="ImportClashMenuItem"
                                                        loc:Localize.Text="Personalize_ImportMenuClash.Text"
                                                        Click="ImportClashConfig_Click" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="OperationInfoBar"
                         IsOpen="False"
                         Severity="Success"
                         IsClosable="True" />
            </StackPanel>

            <!-- ── Footer ──────────────────────────────────────────────────── -->
            <Button loc:Localize.Content="Personalize_Done.Content"
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.DoneCommand}"
                    MinWidth="88"
                    />

        </StackPanel>
    </ScrollView>
</UserControl>
