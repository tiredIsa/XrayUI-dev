<UserControl x:Class="XrayUI.Views.TrafficMonitorControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XrayUI.Helpers"
 xmlns:controls="using:XrayUI.Controls" xmlns:vm="using:XrayUI.ViewModels">
 <UserControl.Resources>
  <Style x:Key="TrafficCard" TargetType="Border">
   <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
   <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
   <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="14,10" />
  </Style>
 </UserControl.Resources>
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
  <VisualStateManager.VisualStateGroups>
   <VisualStateGroup>
    <VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
    <VisualState x:Name="Wide">
     <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
     <VisualState.Setters>
      <Setter Target="Card3.(Grid.Row)" Value="0" /><Setter Target="Card3.(Grid.Column)" Value="2" />
      <Setter Target="Card4.(Grid.Row)" Value="0" /><Setter Target="Card4.(Grid.Column)" Value="3" />
      <Setter Target="ExtraCardColumn.Width" Value="*" /><Setter Target="LastCardColumn.Width" Value="*" />
      <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="1" />
      <Setter Target="FilterBox.(Grid.Row)" Value="0" /><Setter Target="FilterBox.(Grid.Column)" Value="1" />
      <Setter Target="SortBox.(Grid.Row)" Value="0" /><Setter Target="SortBox.(Grid.Column)" Value="2" />
     </VisualState.Setters>
    </VisualState>
   </VisualStateGroup>
  </VisualStateManager.VisualStateGroups>
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
   <StackPanel Spacing="2">
    <TextBlock loc:Localize.Text="Traffic_Title.Text" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
    <ToggleButton loc:Localize.Content="Traffic_Pause.Content" IsChecked="{x:Bind ViewModel.IsPaused, Mode=TwoWay}" AutomationProperties.AutomationId="TrafficPause" />
    <Button loc:Localize.Content="Traffic_Clear.Content" Click="Clear_Click" IsEnabled="{x:Bind ViewModel.CanClear, Mode=OneWay}" AutomationProperties.AutomationId="TrafficClear" />
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" x:Name="Cards" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ExtraCardColumn" Width="0" /><ColumnDefinition x:Name="LastCardColumn" Width="0" /></Grid.ColumnDefinitions>
   <Border Style="{StaticResource TrafficCard}"><StackPanel Spacing="3"><TextBlock loc:Localize.Text="Traffic_Download.Text" FontSize="12" Foreground="#168BBA" /><TextBlock Text="{x:Bind ViewModel.Download, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" /></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource TrafficCard}"><StackPanel Spacing="3"><TextBlock loc:Localize.Text="Traffic_Upload.Text" FontSize="12" Foreground="#A578CE" /><TextBlock Text="{x:Bind ViewModel.Upload, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" /></StackPanel></Border>
   <Border x:Name="Card3" Grid.Row="1" Style="{StaticResource TrafficCard}"><StackPanel Spacing="3"><TextBlock loc:Localize.Text="Traffic_Volume.Text" FontSize="12" /><TextBlock Text="{x:Bind ViewModel.Volume, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" /></StackPanel></Border>
   <Border x:Name="Card4" Grid.Row="1" Grid.Column="1" Style="{StaticResource TrafficCard}"><StackPanel Spacing="3"><TextBlock loc:Localize.Text="Traffic_AccessCount.Text" FontSize="12" /><TextBlock Text="{x:Bind ViewModel.AccessCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" /></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource TrafficCard}">
   <Grid RowDefinitions="Auto,*" RowSpacing="8">
    <Grid ColumnDefinitions="*,Auto">
     <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center"><TextBlock loc:Localize.Text="Traffic_ChartTitle.Text" FontWeight="SemiBold" /><TextBlock Text="↓" Foreground="#168BBA" /><TextBlock Text="↑" Foreground="#A578CE" /></StackPanel>
     <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.WindowIndex, Mode=TwoWay}" MinWidth="100" x:Name="ChartWindow" AutomationProperties.AutomationId="TrafficWindow"><ComboBoxItem loc:Localize.Content="Traffic_FiveMinutes.Content" /><ComboBoxItem loc:Localize.Content="Traffic_FifteenMinutes.Content" /></ComboBox>
    </Grid>
    <controls:TrafficChartControl x:Name="Chart" Grid.Row="1" Height="110" />
   </Grid>
  </Border>
  <Grid Grid.Row="3" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
   <TextBox x:Name="SearchBox" Grid.ColumnSpan="3" loc:Localize.PlaceholderText="Traffic_Search.PlaceholderText" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TrafficSearch" />
   <ComboBox x:Name="FilterBox" Grid.Row="1" SelectedIndex="{x:Bind ViewModel.RouteFilter, Mode=TwoWay}" MinWidth="120" AutomationProperties.AutomationId="TrafficFilter">
    <ComboBoxItem loc:Localize.Content="Traffic_AllRoutes.Content" /><ComboBoxItem loc:Localize.Content="Traffic_Proxy.Content" /><ComboBoxItem loc:Localize.Content="Traffic_Direct.Content" /><ComboBoxItem loc:Localize.Content="Traffic_Blocked.Content" />
   </ComboBox>
   <ComboBox x:Name="SortBox" Grid.Row="1" Grid.Column="1" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" MinWidth="120" AutomationProperties.AutomationId="TrafficSort">
    <ComboBoxItem loc:Localize.Content="Traffic_Newest.Content" /><ComboBoxItem loc:Localize.Content="Traffic_ByAddress.Content" />
   </ComboBox>
  </Grid>
  <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <TextBlock Text="{x:Bind ViewModel.RowCount, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
   <Button Grid.Column="1" loc:Localize.Content="Traffic_Details.Content" Click="Details_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Padding="10,3" />
  </Grid>
  <Border Grid.Row="5" Style="{StaticResource TrafficCard}" Padding="0">
   <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="76,*,100" Padding="12,8"><TextBlock loc:Localize.Text="Traffic_Time.Text" FontSize="12" /><TextBlock Grid.Column="1" loc:Localize.Text="Traffic_Destination.Text" FontSize="12" /><TextBlock Grid.Column="2" loc:Localize.Text="Traffic_Route.Text" FontSize="12" /></Grid>
    <ListView Grid.Row="1" x:Name="AccessList" ItemsSource="{x:Bind ViewModel.Rows}" SelectedItem="{x:Bind ViewModel.SelectedRow, Mode=TwoWay}" SelectionMode="Single" DoubleTapped="AccessList_DoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="TrafficAccesses">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12,6" /><Setter Property="MinHeight" Value="48" /></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="vm:TrafficDisplayRow">
      <Grid ColumnDefinitions="76,*,100" ColumnSpacing="0">
       <TextBlock Text="{x:Bind Time, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
       <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,8,0"><TextBlock Text="{x:Bind Destination, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Context, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
       <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="5" BorderThickness="1" BorderBrush="{x:Bind RouteColor, Mode=OneWay}" Padding="8,3"><TextBlock Text="{x:Bind Route, Mode=OneWay}" Foreground="{x:Bind RouteColor, Mode=OneWay}" FontSize="12" /></Border>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340" Margin="16" Spacing="8" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
     <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
     <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
