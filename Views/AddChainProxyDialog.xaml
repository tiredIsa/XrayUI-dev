<?xml version="1.0" encoding="utf-8"?>

<UserControl
    x:Class="XrayUI.Views.AddChainProxyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:XrayUI.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XrayUI.Models"
    mc:Ignorable="d">

    <StackPanel Spacing="16" MinWidth="340" MaxWidth="400">

        <StackPanel Spacing="6">
            <TextBlock loc:Localize.Text="ChainProxy_NameLabel.Text"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox x:Name="NameTextBox"
                     loc:Localize.PlaceholderText="ChainProxy_NameBox.PlaceholderText"
                     />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock loc:Localize.Text="ChainProxy_EntryLabel.Text"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="EntryComboBox"
                      loc:Localize.PlaceholderText="ChainProxy_EntryBox.PlaceholderText"
                      HorizontalAlignment="Stretch"
                      >
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerEntry">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Name, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind DisplayProtocol, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind Protocol, Mode=OneWay, Converter={StaticResource ProtocolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock loc:Localize.Text="ChainProxy_ExitLabel.Text"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="ExitComboBox"
                      loc:Localize.PlaceholderText="ChainProxy_ExitBox.PlaceholderText"
                      HorizontalAlignment="Stretch"
                      >
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerEntry">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Name, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind DisplayProtocol, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Bind Protocol, Mode=OneWay, Converter={StaticResource ProtocolToBrushConverter}}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock loc:Localize.Text="ChainProxy_Hint.Text"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

    </StackPanel>
</UserControl>