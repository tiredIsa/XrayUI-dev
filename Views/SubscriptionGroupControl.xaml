<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:XrayUI.Helpers" xmlns:vm="using:XrayUI.ViewModels" xmlns:views="using:XrayUI.Views" x:Class="XrayUI.Views.SubscriptionGroupControl">
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <Grid ColumnSpacing="12" Margin="16,4,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AnchorHeader" Height="32" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="Transparent" Margin="0,0,6,0" VerticalAlignment="Center" Padding="2"
                                Visibility="{x:Bind Model.IsAutoRefreshDisabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Loaded="AutoRefreshDisabled_Loaded">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M 4.4,4.8 C 5.1,3.4 6.4,2.5 8,2.5 C 10.3,2.5 12.2,4.2 12.4,6.4 C 13.9,6.5 15,7.7 15,9.1 C 15,10.5 14,11.6 12.7,11.8 M 10.5,11.8 L 4,11.8 C 2.3,11.8 1,10.5 1,8.9 C 1,7.6 1.9,6.4 3.2,6.1"
                                          Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Path Data="M 2,2 L 14,14" Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                          StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Model.Title, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0">
                    <Button Width="32" Height="32" Padding="0" CornerRadius="6" Command="{x:Bind Model.RefreshCommand}" IsEnabled="{x:Bind Model.CanRefresh, Mode=OneWay}" Visibility="{x:Bind Model.HasSubscription, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Loaded="GroupRefresh_Loaded">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                    <Button Width="32" Height="32" Padding="0" CornerRadius="6" Command="{x:Bind Model.TestCommand}" IsEnabled="{x:Bind Model.CanTest, Mode=OneWay}" Background="Transparent" BorderThickness="0" Loaded="GroupTest_Loaded">
                        <FontIcon Glyph="" FontSize="14"/>
                    </Button>
                    <Button Width="32" Height="32" Padding="0" CornerRadius="6" Visibility="{x:Bind Model.HasSubscription, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Background="Transparent" BorderThickness="0" Loaded="GroupMenu_Loaded">
                        <FontIcon Glyph="" FontSize="14"/>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem loc:Localize.Text="Groups_Settings" Command="{x:Bind Model.ConfigureCommand}" IsEnabled="{x:Bind Model.CanRefresh, Mode=OneWay}" Visibility="{x:Bind Model.HasSubscription, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph=""/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Localize.Text="Groups_DeleteTitle" Command="{x:Bind Model.DeleteCommand}" IsEnabled="{x:Bind Model.CanRefresh, Mode=OneWay}" Visibility="{x:Bind Model.HasSubscription, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph=""/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
            <Expander x:Name="GroupExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind Model.IsExpanded, Mode=OneWay}" MinHeight="44" Padding="4,6,4,6" CornerRadius="0,0,8,8">
                <Expander.Resources>
                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent"/>
                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                    <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
                </Expander.Resources>
                <Expander.Header>
                    <Border Padding="0" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind Model.CompactSummary, Mode=OneWay}" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind Model.DetailsTooltip, Mode=OneWay}"/>
                            <ProgressBar Value="{x:Bind Model.UsagePercent, Mode=OneWay}" Maximum="100" Height="3" Visibility="{x:Bind Model.HasQuota, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ProgressBar IsIndeterminate="True" Height="3" Visibility="{x:Bind Model.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind Model.ProgressText, Mode=OneWay}" FontSize="11" Visibility="{x:Bind Model.IsTesting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{x:Bind Model.Error, Mode=OneWay}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{x:Bind Model.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </Expander.Header>
                <ItemsRepeater x:Name="Rows" ItemsSource="{x:Bind Model.Rows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServerRowViewModel">
                            <views:ServerRowControl Model="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
