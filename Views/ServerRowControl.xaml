<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:XrayUI.Helpers" xmlns:vm="using:XrayUI.ViewModels" xmlns:views="using:XrayUI.Views" x:Class="XrayUI.Views.ServerRowControl">
    <ListViewItem x:Name="Row" IsSelected="{x:Bind Model.IsSelected, Mode=OneWay}" HorizontalContentAlignment="Stretch" Padding="4,0" Tapped="RowTapped" KeyDown="RowKeyDown">
        <Grid Background="Transparent" ContextRequested="ServerItem_ContextRequested" DoubleTapped="ServerItem_DoubleTapped">
            <StackPanel Orientation="Vertical" Spacing="6" Margin="4,7,4,7">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="CountryFlag" Width="20" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                               Visibility="{x:Bind Model.HasCountry, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                               ToolTipService.ToolTip="{x:Bind Model.CountryName, Mode=OneWay}" AutomationProperties.Name="{x:Bind Model.CountryName, Mode=OneWay}">
                            <Image.Source><SvgImageSource UriSource="{x:Bind Model.FlagUri, Mode=OneWay}"/></Image.Source>
                        </Image>
                        <TextBlock Grid.Column="1" Text="{x:Bind Model.Server.Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Border Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="3" Padding="6,2" Visibility="{x:Bind Model.Server.IsActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Opacity="{x:Bind views:ServerListControl.ActiveBadgeOpacity(Model.Server.IsActive), Mode=OneWay}" Scale="{x:Bind views:ServerListControl.ActiveBadgeScale(Model.Server.IsActive), Mode=OneWay}" Grid.Column="1" Margin="8,0,0,0" SizeChanged="ActiveBadge_SizeChanged">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.18"/>
                        </Border.OpacityTransition>
                        <Border.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.18"/>
                        </Border.ScaleTransition>
                        <TextBlock loc:Localize.Text="ServerList_ActivatedBadge.Text" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Model.Server.IsChain, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind Model.Server.Host, Mode=OneWay}" MaxWidth="180" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind Model.Server.Port, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind Model.Server.DisplayProtocol, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind Model.Server.Protocol, Mode=OneWay, Converter={StaticResource ProtocolToBrushConverter}}"/>
                    </StackPanel>
                    <TextBlock loc:Localize.Text="ServerList_ChainBadgeText.Text" Visibility="{x:Bind Model.Server.IsChain, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{x:Bind Model.Server.Protocol, Mode=OneWay, Converter={StaticResource ProtocolToBrushConverter}}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Model.Server.LatencyText, Mode=OneWay}" Visibility="{x:Bind Model.Server.HasLatency, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="13.5" FontWeight="SemiBold" Foreground="{x:Bind views:ServerListControl.LatencyForeground(Model.Server.LatencyMs), Mode=OneWay}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </ListViewItem>
</UserControl>
